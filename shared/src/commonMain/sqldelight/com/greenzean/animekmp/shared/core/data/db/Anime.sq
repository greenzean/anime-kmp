-- Local cache of anime details, keyed by the MAL id (ADR 0009). The server stores ids only, never titles.
CREATE TABLE anime (
    mal_id INTEGER NOT NULL PRIMARY KEY,
    title  TEXT    NOT NULL
);

selectAll:
SELECT * FROM anime ORDER BY title;

selectByMalId:
SELECT * FROM anime WHERE mal_id = ?;

insertOrIgnore:
INSERT OR IGNORE INTO anime (mal_id, title) VALUES (?, ?);

countAll:
SELECT count(*) FROM anime;

existsByMalId:
SELECT count(*) FROM anime WHERE mal_id = ?;

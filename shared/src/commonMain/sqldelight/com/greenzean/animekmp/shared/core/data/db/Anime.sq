CREATE TABLE anime (
    id     INTEGER NOT NULL PRIMARY KEY,
    mal_id INTEGER NOT NULL UNIQUE,
    title  TEXT    NOT NULL
);

selectAll:
SELECT * FROM anime ORDER BY title;

selectByMalId:
SELECT * FROM anime WHERE mal_id = ?;

-- id is the server anime.id, never a locally assigned rowid: list_entry.anime_id is synced as-is.
insertOrIgnore:
INSERT OR IGNORE INTO anime (id, mal_id, title) VALUES (?, ?, ?);

countAll:
SELECT count(*) FROM anime;

CREATE TABLE parked_change (
    id         TEXT    NOT NULL PRIMARY KEY,
    mal_id     INTEGER NOT NULL UNIQUE,
    status     TEXT    NOT NULL,
    progress   INTEGER NOT NULL DEFAULT 0,
    score      INTEGER,
    updated_at INTEGER NOT NULL,
    deleted_at INTEGER
);

selectAll:
SELECT * FROM parked_change;

selectByMalId:
SELECT * FROM parked_change WHERE mal_id = ?;

insertOrReplace:
INSERT OR REPLACE INTO parked_change (id, mal_id, status, progress, score, updated_at, deleted_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM parked_change WHERE id = ?;

deleteByMalId:
DELETE FROM parked_change WHERE mal_id = ?;

deleteAll:
DELETE FROM parked_change;

selectMissingAnime:
SELECT parked_change.mal_id FROM parked_change
LEFT JOIN anime ON anime.mal_id = parked_change.mal_id
WHERE anime.mal_id IS NULL;



CREATE TABLE list_entry (
    id         TEXT    NOT NULL PRIMARY KEY,
    mal_id     INTEGER NOT NULL REFERENCES anime (mal_id),
    status     TEXT    NOT NULL
        CHECK (status IN ('WATCHING', 'COMPLETED', 'ON_HOLD', 'DROPPED', 'PLAN_TO_WATCH')),
    updated_at INTEGER NOT NULL,
    deleted_at INTEGER,
    sync_state TEXT    NOT NULL DEFAULT 'PENDING'
        CHECK (sync_state IN ('PENDING', 'SYNCED')),
    UNIQUE (mal_id)
);

CREATE INDEX list_entry_updated_idx ON list_entry (updated_at);

selectActiveWithAnime:
SELECT list_entry.id, list_entry.mal_id, list_entry.status,
       list_entry.updated_at, list_entry.sync_state, anime.title
FROM list_entry
JOIN anime ON anime.mal_id = list_entry.mal_id
WHERE list_entry.deleted_at IS NULL
ORDER BY anime.title;

selectByMalId:
SELECT * FROM list_entry WHERE mal_id = ?;

selectPending:
SELECT * FROM list_entry WHERE sync_state = 'PENDING' ORDER BY updated_at;

updatePending:
UPDATE list_entry
SET status = :status, updated_at = :updatedAt, deleted_at = NULL, sync_state = 'PENDING'
WHERE mal_id = :malId;

insertPending:
INSERT OR IGNORE INTO list_entry (id, mal_id, status, updated_at, deleted_at, sync_state)
VALUES (?, ?, ?, ?, NULL, 'PENDING');

softDelete:
UPDATE list_entry
SET deleted_at = :now, updated_at = :now, sync_state = 'PENDING'
WHERE mal_id = :malId AND deleted_at IS NULL;

markSynced:
UPDATE list_entry SET sync_state = 'SYNCED' WHERE id = ? AND updated_at = ?;

selectPendingBatch:
SELECT * FROM list_entry WHERE sync_state = 'PENDING' ORDER BY updated_at LIMIT :limit;

rewriteId:
UPDATE list_entry SET id = :newId WHERE id = :oldId;

updatePulled:
UPDATE list_entry
SET status = :status, updated_at = :updatedAt, deleted_at = :deletedAt, sync_state = 'SYNCED'
WHERE id = :id;

insertPulled:
INSERT OR IGNORE INTO list_entry (id, mal_id, status, updated_at, deleted_at, sync_state)
VALUES (?, ?, ?, ?, ?, 'SYNCED');

countPending:
SELECT COUNT(*) FROM list_entry WHERE sync_state = 'PENDING';

deleteSyncedTombstones:
DELETE FROM list_entry WHERE deleted_at IS NOT NULL AND sync_state = 'SYNCED';

markAllPending:
UPDATE list_entry SET sync_state = 'PENDING';

deleteAll:
DELETE FROM list_entry;

countActive:
SELECT COUNT(*) FROM list_entry WHERE deleted_at IS NULL;

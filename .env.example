# Copy to .env and fill in. Never commit .env.
DATABASE_URL=jdbc:postgresql://localhost:5432/animekmp
DATABASE_USER=animekmp
DATABASE_PASSWORD=animekmp
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
# Google OAuth *web* client ID (the app's server client ID); Google ID tokens must be issued for it
GOOGLE_CLIENT_ID=
# Signs session tokens, at least 32 bytes: openssl rand -base64 48
JWT_SECRET=

# Server runtime
HOST=0.0.0.0
PORT=8080
# dev (readable logs) or prod (JSON logs)
APP_ENV=dev
LOG_LEVEL=INFO
# Compose only: address the server port is published on. 127.0.0.1 (default) or 0.0.0.0 to serve a trusted LAN
# SERVER_BIND=127.0.0.1
